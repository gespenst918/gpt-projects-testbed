{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leiomano glossary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "layer",
    "terms"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "layer": {
      "enum": [
        "universal",
        "domain",
        "safety"
      ]
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "definition",
          "tier",
          "status",
          "sources",
          "related",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(factory|runtime|machinery|mobile|safety)\\.[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "const": 1
          },
          "status": {
            "const": "draft"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
